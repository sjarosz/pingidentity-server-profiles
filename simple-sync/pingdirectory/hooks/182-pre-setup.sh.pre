#!/usr/bin/env
echo Hello from the baseline server profile 182-pre-setup.sh.pre hook!
echo "====> USER_BASE_DN=[${USER_BASE_DN}]"
computedDomain=$(echo ${USER_BASE_DN} | sed 's/^dc=\([^,]*\).*/\1/' )
computedOrg=$(echo ${USER_BASE_DN} | sed 's/^o=\([^,]*\).*/\1/' )

if ! test "${USER_BASE_DN}" = "${computedDomain}"; then
    cat<<END_DOMAIN >>${CONTAINER_ENV}
BASE_VALUE=${computedDomain}
BASE_ATTRIBUTE=dc
BASE_CLASS=domain
END_DOMAIN

elif ! test "${USER_BASE_DN}" = "${computedOrg}"; then
    cat<<END_ORG >>${CONTAINER_ENV}
BASE_VALUE=${computedOrg}
BASE_ATTRIBUTE=o
BASE_CLASS=organization
END_ORG

else
    echo_red "ERROR: the base is expected to be dc=<your domain> or o=<your org>"
    exit 183
fi

echo "****************************************************************************************************************"
echo "Hello from the baseline server profile 99-deploy-groovy-scripts.sh hook!"
echo "****************************************************************************************************************"

# Create the extensions directory if it doesn't exist
#mkdir -p /opt/out/instance/lib/extensions

# Copy the JAR file to the correct location
#cp /opt/staging/pd.profile/server-root/pre-setup/unboundid-ldapsdk.jar /opt/out/instance/lib/extensions/
#chmod +x /opt/out/instance/lib/extensions/unboundid-ldapsdk.jar
# Create the groovy-scripts directory if it doesn't exist
#mkdir -p /opt/out/instance/lib/groovy-scripted-extensions/

# Copy the Groovy script
cp /opt/staging/pd.profile/server-root/pre-setup/groovy-staging/HelloWorldPlugin.groovy /opt/out/instance/lib/groovy-scripted-extensions/
# Set proper permissions
chmod +x /opt/out/instance/lib/groovy-scripted-extensions/HelloWorldPlugin.groovy
