dsconfig set-log-publisher-prop \
  --publisher-name "File-Based Debug Logger" \
  --set enabled:true \
  --no-prompt


  dsconfig create-log-publisher \
  --publisher-name "File-Based Debug Logger" \
  --type file-based-debug \
  --set enabled:true \
  --set log-file:"logs/debug.log" \
  --set logging-level:verbose \
  --no-prompt


dsconfig create-plugin \
  --plugin-name "ExampleScriptedPlugin" \
  --type groovy-scripted \
  --set script-class:ExampleScriptedPlugin \
  --set "script-argument:attribute=description" \
  --set plugin-type:preparseadd \
  --set plugin-type:preparsecompare \
  --set plugin-type:preparsemodify \
  --set plugin-type:preparsemodifydn \
  --set plugin-type:preparsesearch \
  --set plugin-type:searchresultentry \
  --set enabled:false \
  --no-prompt

dsconfig create-plugin \
  --plugin-name "StoreCleartextPassword" \
  --type groovy-scripted \
  --set script-class:StoreCleartextPasswordPlugin \
  --set plugin-type:preparseadd \
  --set plugin-type:preparsemodify \
  --set enabled:true \
  --no-prompt


  dsconfig set-log-publisher-prop \
  --publisher-name "File-Based Debug Logger" \
  --set debug-logging-class:com.unboundid.directory.sdk.examples.groovy.StoreCleartextPasswordPlugin \
  --no-prompt


