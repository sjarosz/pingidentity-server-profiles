
#
# Configure the sync pipe end-to-end
#
dsconfig set-trust-manager-provider-prop \
    --provider-name 'Blind Trust'  \
    --set enabled:true

dsconfig create-external-server \
    --server-name pingdirectory \
    --type ping-identity-ds \
	--set server-host-name:${PD_ENGINE_PRIVATE_HOSTNAME} \
    --set server-port:${PD_ENGINE_PRIVATE_PORT_LDAPS} \
	--set bind-dn:cn=sync \
    --set "password:AABkwRkIRfApR+R1uZPSciaUPmtEtTzjC/4=" \
    --set authorization-method:none \
    --set location:${LOCATION} \
    --set connection-security:ssl \
    --set key-manager-provider:Null \
    --set 'trust-manager-provider:Blind Trust' \
	--set initial-connections:1 \
	--set max-connections:4

dsconfig create-sync-source \
    --source-name pingdirectory_source  \
    --type ping-identity  \
    --set base-dn:ou=source,${USER_BASE_DN}  \
    --set server:pingdirectory  \
    --set use-changelog-batch-request:true

dsconfig create-sync-destination \
	--destination-name pingdirectory_destination \
	--type ping-identity \
	--set base-dn:ou=destination,${USER_BASE_DN} \
	--set server:pingdirectory

dsconfig create-sync-pipe \
    --pipe-name pingdirectory_source-to-pingdirectory_destination  \
    --set sync-source:pingdirectory_source  \
    --set sync-destination:pingdirectory_destination  \
    --set "change-detection-polling-interval:500 ms"  \
    --set num-worker-threads:1

dsconfig create-dn-map \
    --map-name source_to_destination  \
    --set 'from-dn-pattern:**,ou=source,${USER_BASE_DN}'  \
    --set "to-dn-pattern:{1},ou=destination,${USER_BASE_DN}"

dsconfig create-sync-class \
    --pipe-name pingdirectory_source-to-pingdirectory_destination  \
    --class-name everythin_as_is  \
    --set dn-map:source_to_destination  \
    --set ignore-zero-length-values:true  \
    --set modifies-as-creates:true  \
    --set creates-as-modifies:true \
    --set auto-mapped-source-attribute:-all-


dsconfig create-passphrase-provider \
  --provider-name targetldap-pass \
  --type file-based \
  --set enabled:true \
  --set password-file:/opt/out/instance/targetldap-password.txt \
  --no-prompt


dsconfig create-external-server \
  --server-name target-openldap \
  --type ldap \
  --set server-host-name:targetldap \
  --set server-port:389 \
  --set authentication-method:simple \
  --set bind-dn:"cn=admin,dc=example,dc=com" \
  --set passphrase-provider:targetldap-pass \
  --no-prompt


dsconfig create-sync-destination \
  --destination-name external-openldap-target \
  --type generic-ldap \
  --set base-dn:dc=example,dc=com \
  --set server:target-openldap \
  --no-prompt


dsconfig create-sync-pipe \
    --pipe-name pingdirectory_source-to-targetldap  \
    --set sync-source:pingdirectory_source  \
    --set sync-destination:external-openldap-target  \
    --set "change-detection-polling-interval:500 ms"  \
    --set num-worker-threads:1 \
    --no-prompt

# Add the sync filter script to the pipe
dsconfig set-sync-pipe-prop \
  --pipe-name pingdirectory_source-to-targetldap \
  --set sync-filter-script:file:/opt/sync/scripts/sync-filter.groovy \
  --no-prompt

# (Optional) Exclude the marker attribute from the target
dsconfig set-sync-pipe-prop \
  --pipe-name pingdirectory_source-to-targetldap \
  --set exclude-attribute:telephoneNumber \
  --no-prompt

dsconfig create-sync-class \
    --pipe-name "pingdirectory_source-to-targetldap" \
    --class-name "users" \
    --set auto-mapped-source-attribute:-all- \
    --set include-base-dn:"ou=people,ou=source,dc=example,dc=com" \
    --set include-filter:"(objectClass=person)" \
    --set destination-correlation-attributes:uid \
    --set evaluation-order-index:100 \
    --no-prompt



# First, create a DN map to transform the DN structure
dsconfig create-dn-map \
  --map-name "source-to-target-dn-map" \
  --set from-dn-pattern:"**,ou=people,ou=source,dc=example,dc=com" \
  --set to-dn-pattern:"{1},ou=People,dc=example,dc=com" \
  --no-prompt

# Then associate this DN map with your sync class
dsconfig set-sync-class-prop \
  --pipe-name "pingdirectory_source-to-targetldap" \
  --class-name "users" \
  --set modifies-as-creates:true \
  --add dn-map:"source-to-target-dn-map" \
  --no-prompt  

dsconfig create-sync-destination-plugin \
  --plugin-name "SetPasswordFromDescriptionPlugin" \
  --type groovy-scripted-ldap \
  --set "script-class:SetPasswordFromDescriptionPlugin" \
  --no-prompt

dsconfig set-sync-destination-prop \
  --destination-name "external-openldap-target" \
  --add "plugin:SetPasswordFromDescriptionPlugin" \
  --no-prompt


dsconfig set-sync-pipe-prop \
  --pipe-name pingdirectory_source-to-targetldap \
  --set started:true \
  --no-prompt
